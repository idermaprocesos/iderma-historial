<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaCapilar_Historial.Dialogs.ProcedimientoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Procedimiento / operación"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary"
    PrimaryButtonText="Guardar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="560">
        <StackPanel MinWidth="480" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Tipo *" />
                    <ComboBox
                        x:Name="TipoBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="TipoBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Estado" />
                    <ComboBox x:Name="EstadoBox" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Qué es este procedimiento" />
                <TextBlock
                    x:Name="DescripcionTipoText"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Fecha" />
                    <CalendarDatePicker x:Name="FechaBox" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Área tratada" />
                    <TextBox x:Name="AreaBox" PlaceholderText="Coronilla, abdomen, flancos..." />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Hora" />
                    <ComboBox
                        x:Name="HoraBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Seleccionar hora"
                        SelectionChanged="HoraBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Hora exacta" />
                    <TimePicker
                        x:Name="HoraPicker"
                        ClockIdentifier="24HourClock"
                        MinuteIncrement="5"
                        TimeChanged="HoraPicker_TimeChanged" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Unidades foliculares" />
                    <NumberBox x:Name="UfBox" Minimum="0" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Injertos" />
                    <NumberBox x:Name="InjertosBox" Minimum="0" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Duración (min)" />
                    <NumberBox x:Name="DuracionBox" Minimum="0" SpinButtonPlacementMode="Compact" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Médico" />
                    <ComboBox x:Name="MedicoBox" HorizontalAlignment="Stretch" PlaceholderText="Seleccionar médico" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Enfermera" />
                    <ComboBox x:Name="EnfermeraBox" HorizontalAlignment="Stretch" PlaceholderText="Seleccionar enfermera" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Anestesia" />
                    <TextBox x:Name="AnestesiaBox" PlaceholderText="Local, tumescente..." />
                </StackPanel>
            </Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Resultado" />
                <TextBox x:Name="ResultadoBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Complicaciones" />
                <TextBox x:Name="ComplicacionesBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Observaciones del médico" />
                <TextBox
                    x:Name="ObsBox"
                    AcceptsReturn="True"
                    Height="88"
                    PlaceholderText="Hallazgos, técnica, tolerancia, indicaciones y plan..."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Costo" />
                <NumberBox x:Name="CostoBox" Minimum="0" SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
