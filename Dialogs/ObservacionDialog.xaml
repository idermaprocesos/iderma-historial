<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="IdermaCapilar_Historial.Dialogs.ObservacionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Observación clínica"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary"
    PrimaryButtonText="Guardar"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="460" Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Tipo" />
                <ComboBox x:Name="TipoBox" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Fecha" />
                <CalendarDatePicker x:Name="FechaBox" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Título" />
            <TextBox x:Name="TituloBox" PlaceholderText="Ej. Control a 15 días" />
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Detalle *" />
            <TextBox
                x:Name="ContenidoBox"
                AcceptsReturn="True"
                Height="140"
                PlaceholderText="Evolución, indicaciones, hallazgos..."
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Autor / médico" />
            <ComboBox x:Name="AutorBox" HorizontalAlignment="Stretch" PlaceholderText="Seleccionar médico" />
        </StackPanel>
        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
