<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.CitasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaCapilar_Historial.Models"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootStyle}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Agenda de citas" />
                <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.Resumen, Mode=OneWay}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Click="ImprimirSemana_Click" Content="Imprimir semana" />
                <Button
                    Click="Nueva_Click"
                    Content="Nueva cita"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="Anterior_Click" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Anterior" />
                <Button Click="Hoy_Click" Content="Hoy" />
                <Button Click="Siguiente_Click" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Siguiente" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.TituloPeriodo, Mode=OneWay}" />
            </StackPanel>
            <SelectorBar
                x:Name="VistaBar"
                Grid.Column="2"
                SelectionChanged="VistaBar_SelectionChanged">
                <SelectorBarItem Text="Día" Tag="Día" />
                <SelectorBarItem Text="Semana" Tag="Semana" />
                <SelectorBarItem Text="Mes" Tag="Mes" />
                <SelectorBarItem Text="Agenda" Tag="Agenda" />
            </SelectorBar>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,4,0,0" Spacing="6">
            <ItemsControl ItemsSource="{x:Bind LeyendaCitas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TipoCitaOpcion">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <Border
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Background="{x:Bind Brocha}"
                                CornerRadius="3" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.8"
                                Text="{x:Bind Nombre}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Bind LeyendaOperaciones}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TipoCitaOpcion">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <Border
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Background="{x:Bind Brocha}"
                                CornerRadius="3" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.8"
                                Text="{x:Bind Nombre}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border
            Grid.Row="3"
            Padding="12"
            Style="{StaticResource CardBorderStyle}">

            <Grid>
                <!-- Mes -->
                <Grid Visibility="{x:Bind ViewModel.EsVistaMes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="MesEncabezados" Margin="0,0,0,6" />
                    <Grid x:Name="MesCuerpo" Grid.Row="1" />
                </Grid>

                <!-- Semana -->
                <Grid Visibility="{x:Bind ViewModel.EsVistaSemana, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SemanaEncabezados" Margin="0,0,0,4" />
                    <ScrollViewer
                        x:Name="SemanaScroll"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        SizeChanged="SemanaScroll_SizeChanged">
                        <Grid x:Name="SemanaCuerpo" />
                    </ScrollViewer>
                </Grid>

                <!-- Día -->
                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.EsVistaDia, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SlotsDia, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CalendarioSlot">
                                    <Grid
                                        MinHeight="52"
                                        Margin="0,0,0,4"
                                        Padding="2,2"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="12"
                                            Opacity="0.65"
                                            Text="{x:Bind HoraTexto}" />
                                        <Button
                                            Grid.Column="1"
                                            MinHeight="44"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="Slot_Click"
                                            Style="{StaticResource SlotRowButtonStyle}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind SinCitas, Converter={StaticResource BoolToVisibility}}">
                                            <Border
                                                MinHeight="44"
                                                Padding="10,8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Opacity="0.45"
                                                    Text="Libre — pulse para agendar" />
                                            </Border>
                                        </Button>
                                        <ItemsControl
                                            Grid.Column="1"
                                            ItemsSource="{x:Bind Citas}"
                                            Visibility="{x:Bind HayCitas, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:EventoCalendario">
                                                    <Button
                                                        Margin="0,0,0,6"
                                                        Padding="10,8"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="{x:Bind ColorEstado}"
                                                        BorderThickness="0"
                                                        Click="Cita_Click"
                                                        CornerRadius="8"
                                                        Foreground="White"
                                                        Style="{StaticResource CitaTarjetaButtonStyle}"
                                                        Tag="{x:Bind}">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind NombrePaciente}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="12" Opacity="0.95" Text="{x:Bind HorarioTexto}" />
                                                            <TextBlock FontSize="11" Opacity="0.9" Text="{x:Bind Resumen}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border
                        Grid.Column="1"
                        Padding="14"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Agenda del día" />
                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                Text="No hay citas ni operaciones este día."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.SinCitasDia, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <ListView
                                Grid.Row="1"
                                IsItemClickEnabled="True"
                                ItemClick="CitaLista_ItemClick"
                                ItemsSource="{x:Bind ViewModel.EventosDia, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind ViewModel.HayCitasDia, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,4" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EventoCalendario">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Background="{x:Bind ColorEstado}"
                                                CornerRadius="3" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind NombrePaciente}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind HorarioTexto}" />
                                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Resumen}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Click="Comprobante_Click"
                                                Content="Boleta"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Generar boleta o factura"
                                                Visibility="{x:Bind EsCita, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Agenda -->
                <Grid Visibility="{x:Bind ViewModel.EsVistaAgenda, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Text="No hay citas ni operaciones en este periodo."
                        Visibility="{x:Bind ViewModel.SinAgenda, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ListView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Agenda, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HayAgenda, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AgendaGrupo">
                                <StackPanel Margin="0,8,0,16" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Encabezado}" />
                                    <ItemsControl ItemsSource="{x:Bind Citas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventoCalendario">
                                                <Grid Padding="0,6" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        Padding="8,6"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="{x:Bind ColorEstado}"
                                                        BorderThickness="0"
                                                        Click="Cita_Click"
                                                        CornerRadius="8"
                                                        Foreground="White"
                                                        Style="{StaticResource CitaTarjetaButtonStyle}"
                                                        Tag="{x:Bind}">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind NombrePaciente}" />
                                                            <TextBlock Opacity="0.95" Text="{x:Bind Resumen}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Grid.Column="1"
                                                        VerticalAlignment="Stretch"
                                                        Click="Comprobante_Click"
                                                        Content="Boleta o factura"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind EsCita, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        VerticalAlignment="Stretch"
                                                        Click="Expediente_Click"
                                                        Content="Expediente"
                                                        Tag="{x:Bind}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
