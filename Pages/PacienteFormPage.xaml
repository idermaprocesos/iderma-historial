<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.PacienteFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer
            BringIntoViewOnFocusChange="False"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,24,32,16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Titulo, Mode=OneWay}" />
                        <TextBlock Opacity="0.72" Text="Identidad, contacto y emergencia. El expediente médico se completa en la ficha del paciente." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IdermaTealBrush}"
                            Text="{x:Bind ViewModel.Paciente.NumeroExpediente, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Opacity="0.65"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind AutoGuardado.Estado, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Identidad" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Nombres *" PlaceholderText="Nombres" Text="{x:Bind ViewModel.Paciente.Nombres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Apellidos *" PlaceholderText="Apellidos" Text="{x:Bind ViewModel.Paciente.Apellidos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="Tipo de documento"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.TiposDocumento}"
                                    PlaceholderText="Seleccionar"
                                    SelectedItem="{x:Bind ViewModel.Paciente.TipoDocumento, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="Número de documento"
                                    PlaceholderText="DNI / CE / Pasaporte"
                                    Text="{x:Bind ViewModel.Paciente.NumeroDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker
                                    x:Name="NacimientoPicker"
                                    Header="Fecha de nacimiento"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="Nacimiento_DateChanged"
                                    PlaceholderText="Seleccionar fecha" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="Sexo"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Sexos}"
                                    PlaceholderText="Seleccionar"
                                    SelectedItem="{x:Bind ViewModel.Paciente.Sexo, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="2"
                                    Header="Estado civil"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.EstadosCiviles}"
                                    PlaceholderText="Seleccionar"
                                    SelectedItem="{x:Bind ViewModel.Paciente.EstadoCivil, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Ocupación" PlaceholderText="Profesión u oficio" Text="{x:Bind ViewModel.Paciente.Ocupacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Nacionalidad" Text="{x:Bind ViewModel.Paciente.Nacionalidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Contacto y domicilio" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Teléfono" InputScope="TelephoneNumber" PlaceholderText="999 000 000" Text="{x:Bind ViewModel.Paciente.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="Telefono_TextChanging" />
                                <TextBox Grid.Column="1" Header="Teléfono alterno" InputScope="TelephoneNumber" PlaceholderText="999 000 000" Text="{x:Bind ViewModel.Paciente.TelefonoAlterno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="Telefono_TextChanging" />
                            </Grid>
                            <TextBox Header="Correo electrónico" PlaceholderText="correo@ejemplo.com" Text="{x:Bind ViewModel.Paciente.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Dirección" PlaceholderText="Calle, número, urbanización" Text="{x:Bind ViewModel.Paciente.Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Distrito" Text="{x:Bind ViewModel.Paciente.Distrito, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Ciudad" Text="{x:Bind ViewModel.Paciente.Ciudad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Contacto de emergencia" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Nombre completo" PlaceholderText="Persona a quien avisar" Text="{x:Bind ViewModel.Contacto.Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                Header="Parentesco"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.RelacionesEmergencia}"
                                PlaceholderText="Seleccionar"
                                SelectedItem="{x:Bind ViewModel.Contacto.Relacion, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Header="Teléfono" InputScope="TelephoneNumber" PlaceholderText="999 000 000" Text="{x:Bind ViewModel.Contacto.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="Telefono_TextChanging" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                    <TextBox
                        AcceptsReturn="True"
                        Header="Motivo de consulta y notas iniciales"
                        Height="96"
                        PlaceholderText="Síntomas, referidos, observaciones de la primera visita"
                        Text="{x:Bind ViewModel.Paciente.NotasGenerales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="32,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Click="Cancelar_Click" Content="Cancelar" />
                <Button Click="Guardar_Click" Content="Guardar y abrir expediente" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
        </Grid>

        <InfoBar
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.HayError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error"
            Style="{StaticResource OverlayInfoBarStyle}" />
        <InfoBar
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.HayAviso, Mode=OneWay}"
            Message="{x:Bind ViewModel.Aviso, Mode=OneWay}"
            Severity="Success"
            Style="{StaticResource OverlayInfoBarStyle}" />
    </Grid>
</Page>
