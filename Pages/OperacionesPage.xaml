<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.OperacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaCapilar_Historial.Models"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Operaciones" />
            <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.Resumen, Mode=OneWay}" />
        </StackPanel>

        <AutoSuggestBox
            Grid.Row="1"
            Height="36"
            VerticalAlignment="Center"
            PlaceholderText="Buscar por paciente, tipo, estado, médico, enfermera o área"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.Busqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Border Grid.Row="2" Padding="8" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SinOperaciones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="36" Glyph="&#xE95E;" Opacity="0.5" />
                    <TextBlock HorizontalAlignment="Center" Opacity="0.7" Text="No hay operaciones que coincidan con la búsqueda." />
                </StackPanel>
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="Lista_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Operaciones, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HayOperaciones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView.Footer>
                        <Button
                            Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Click="CargarMas_Click"
                            Content="Mostrar más operaciones"
                            Visibility="{x:Bind ViewModel.HayMas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </ListView.Footer>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Procedimiento">
                            <Grid Padding="8,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind NombrePaciente}" />
                                    <TextBlock Opacity="0.85" Text="{x:Bind Tipo}" />
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="{x:Bind DescripcionProcedimiento}" />
                                    <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind DetalleLista}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource IdermaTealBrush}"
                                    Text="{x:Bind Estado}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
