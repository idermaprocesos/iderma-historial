<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.PacientesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaCapilar_Historial.Models"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Pacientes" />
                <TextBlock Opacity="0.7" Text="{x:Bind ViewModel.Resumen, Mode=OneWay}" />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="Nuevo_Click"
                Content="Nuevo expediente"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                Height="36"
                VerticalAlignment="Center"
                PlaceholderText="Buscar por nombre, expediente, documento, teléfono o correo"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.Busqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                VerticalAlignment="Center"
                IsOn="{x:Bind ViewModel.SoloActivos, Mode=TwoWay}"
                OffContent="Todos"
                OnContent="Solo activos" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SinPacientes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="36" Glyph="&#xE716;" Opacity="0.5" />
                    <TextBlock HorizontalAlignment="Center" Opacity="0.7" Text="No hay expedientes que coincidan con la búsqueda." />
                    <Button HorizontalAlignment="Center" Click="Nuevo_Click" Content="Crear expediente" />
                </StackPanel>
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="Lista_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Pacientes, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HayPacientes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView.Footer>
                        <Button
                            Margin="0,8,0,4"
                            HorizontalAlignment="Center"
                            Click="CargarMas_Click"
                            Content="Mostrar más expedientes"
                            Visibility="{x:Bind ViewModel.HayMas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </ListView.Footer>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Paciente">
                            <Grid Padding="8,10" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="VerFoto_Click"
                                    CornerRadius="999"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Ver fotografía">
                                    <PersonPicture
                                        Width="46"
                                        Height="46"
                                        DisplayName="{x:Bind NombreCompleto}"
                                        ProfilePicture="{x:Bind Foto, Mode=OneWay}" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind NombreCompleto}" />
                                    <TextBlock Opacity="0.75" Text="{x:Bind Subtitulo}" />
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Email}"
                                        Visibility="{x:Bind Email, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource IdermaTealBrush}" Text="{x:Bind NumeroExpediente}" />
                                    <TextBlock HorizontalAlignment="Right" Opacity="0.65" Text="{x:Bind Ciudad}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
