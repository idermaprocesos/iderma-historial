<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.PacienteDetallePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaCapilar_Historial.Models"
    xmlns:controls="using:IdermaCapilar_Historial.Controls"
    mc:Ignorable="d">

    <Grid Style="{StaticResource PageRootStyle}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="VerFoto_Click"
                    CornerRadius="999"
                    ToolTipService.ToolTip="Ver fotografía">
                    <PersonPicture
                        x:Name="FotoPaciente"
                        Width="64"
                        Height="64"
                        DisplayName="{x:Bind ViewModel.Paciente.NombreCompleto, Mode=OneWay}"
                        ProfilePicture="{x:Bind ViewModel.Foto, Mode=OneWay}" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Paciente.NombreCompleto, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Opacity="0.8"
                        Text="{x:Bind ViewModel.Paciente.Subtitulo, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="Subtítulo del expediente: número de historia, edad, sexo y teléfono. Sirve para identificar al paciente de un vistazo." />
                    <TextBlock
                        Opacity="0.62"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Historial médico para registrar evaluación capilar, operaciones capilares y de reducción de grasa, mapas de zonas y seguimiento."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind AutoGuardado.Estado, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinWidth="112"
                        Content="Imprimir"
                        ToolTipService.ToolTip="Imprimir datos o historial">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Click="ImprimirDatos_Click" Text="Datos del paciente" />
                                <MenuFlyoutItem Click="ImprimirHistorial_Click" Text="Historial clínico" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        Click="Foto_Click"
                        Content="Fotografía"
                        ToolTipService.ToolTip="Cambiar o quitar fotografía" />
                    <Button
                        Click="Eliminar_Click"
                        Content="Eliminar"
                        ToolTipService.ToolTip="Eliminar expediente" />
                </StackPanel>
            </Grid>
        </Border>

        <Pivot x:Name="DetallePivot" Grid.Row="1" BringIntoViewRequested="Pivot_BringIntoViewRequested">
            <PivotItem Header="Datos personales">
                <ScrollViewer
                    Padding="4,16,4,8"
                    BringIntoViewOnFocusChange="False"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="N.º expediente" />
                                <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.Paciente.NumeroExpediente, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Nombres" />
                                <TextBox Text="{x:Bind ViewModel.Paciente.Nombres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Apellidos" />
                                <TextBox Text="{x:Bind ViewModel.Paciente.Apellidos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Tipo de documento" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.TiposDocumento}" SelectedItem="{x:Bind ViewModel.Paciente.TipoDocumento, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="Número de documento" Text="{x:Bind ViewModel.Paciente.NumeroDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CalendarDatePicker
                                x:Name="NacimientoPicker"
                                Grid.Column="2"
                                Header="Fecha de nacimiento"
                                HorizontalAlignment="Stretch"
                                DateChanged="Nacimiento_DateChanged" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Sexo" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Sexos}" SelectedItem="{x:Bind ViewModel.Paciente.Sexo, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" Header="Estado civil" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EstadosCiviles}" SelectedItem="{x:Bind ViewModel.Paciente.EstadoCivil, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Header="Ocupación" Text="{x:Bind ViewModel.Paciente.Ocupacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Nacionalidad" Text="{x:Bind ViewModel.Paciente.Nacionalidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="Teléfono" InputScope="TelephoneNumber" PlaceholderText="999 000 000" Text="{x:Bind ViewModel.Paciente.Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="Telefono_TextChanging" />
                            <TextBox Grid.Column="2" Header="Teléfono alterno" InputScope="TelephoneNumber" PlaceholderText="999 000 000" Text="{x:Bind ViewModel.Paciente.TelefonoAlterno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="Telefono_TextChanging" />
                        </Grid>
                        <TextBox Header="Correo electrónico" Text="{x:Bind ViewModel.Paciente.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Dirección" Text="{x:Bind ViewModel.Paciente.Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="Distrito" Text="{x:Bind ViewModel.Paciente.Distrito, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Header="Ciudad" Text="{x:Bind ViewModel.Paciente.Ciudad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBox
                            AcceptsReturn="True"
                            Header="Notas generales del expediente"
                            Height="90"
                            Text="{x:Bind ViewModel.Paciente.NotasGenerales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <ToggleSwitch Header="Expediente activo" IsOn="{x:Bind ViewModel.Paciente.Activo, Mode=TwoWay}" OffContent="Inactivo" OnContent="Activo" />
                        <Button Click="GuardarPersonales_Click" Content="Guardar datos personales" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Emergencia">
                <Grid Padding="4,16,4,8" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="Contactos a quienes notificar en una emergencia." />
                        <Button HorizontalAlignment="Right" Click="NuevoContacto_Click" Content="Agregar contacto" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="No hay contactos de emergencia registrados."
                        Visibility="{x:Bind ViewModel.SinContactos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Contactos, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HayContactos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContactoEmergencia">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                                        <TextBlock Opacity="0.75" Text="{x:Bind Detalle}" />
                                        <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Email}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="EditarContacto_Click" Content="Editar" Tag="{x:Bind}" />
                                        <Button Click="EliminarContacto_Click" Content="Quitar" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Datos médicos">
                <ScrollViewer
                    Padding="4,16,4,8"
                    BringIntoViewOnFocusChange="False"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Opacity="0.75" Text="Alergias, medicamentos y antecedentes relevantes para cualquier procedimiento." />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Grupo sanguíneo" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.GruposSanguineos}" SelectedItem="{x:Bind ViewModel.DatosMedicos.GrupoSanguineo, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="Peso (kg)"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.DatosMedicos.PesoKg, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                            <NumberBox
                                Grid.Column="2"
                                Header="Talla (cm)"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.DatosMedicos.TallaCm, Mode=TwoWay, Converter={StaticResource NullableDouble}}" />
                            <TextBox Grid.Column="3" Header="Presión arterial" PlaceholderText="120/80" Text="{x:Bind ViewModel.DatosMedicos.PresionArterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.DatosMedicos.ImcTexto, Mode=OneWay}"
                            Severity="Informational"
                            Title="IMC"
                            Visibility="{x:Bind ViewModel.DatosMedicos.ImcTexto, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Tabaco" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Habitos}" SelectedItem="{x:Bind ViewModel.DatosMedicos.Fuma, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" Header="Alcohol" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Habitos}" SelectedItem="{x:Bind ViewModel.DatosMedicos.Alcohol, Mode=TwoWay}" />
                        </Grid>
                        <TextBox AcceptsReturn="True" Header="Alergias" Height="72" PlaceholderText="Medicamentos, látex, anestésicos..." Text="{x:Bind ViewModel.DatosMedicos.Alergias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Medicamentos actuales" Height="72" Text="{x:Bind ViewModel.DatosMedicos.MedicamentosActuales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Antecedentes personales" Height="72" Text="{x:Bind ViewModel.DatosMedicos.AntecedentesPersonales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Antecedentes familiares" Height="72" PlaceholderText="Alopecia, diabetes, hipertensión..." Text="{x:Bind ViewModel.DatosMedicos.AntecedentesFamiliares, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Enfermedades crónicas" Height="72" Text="{x:Bind ViewModel.DatosMedicos.EnfermedadesCronicas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Cirugías previas" Height="72" Text="{x:Bind ViewModel.DatosMedicos.CirugiasPrevias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <Button Click="GuardarMedicos_Click" Content="Guardar datos médicos" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Evaluación capilar">
                <ScrollViewer
                    Padding="4,16,4,8"
                    BringIntoViewOnFocusChange="False"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Opacity="0.75" Text="Diagnóstico, escalas y plan de tratamiento del expediente capilar." />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Tipo de alopecia" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.TiposAlopecia}" SelectedItem="{x:Bind ViewModel.DatosMedicos.TipoAlopecia, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" Header="Escala Norwood (hombres)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EscalasNorwood}" SelectedItem="{x:Bind ViewModel.DatosMedicos.EscalaNorwood, Mode=TwoWay}" />
                            <ComboBox Grid.Column="2" Header="Escala Ludwig (mujeres)" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EscalasLudwig}" SelectedItem="{x:Bind ViewModel.DatosMedicos.EscalaLudwig, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Zona afectada" PlaceholderText="Entradas, coronilla, línea frontal..." Text="{x:Bind ViewModel.DatosMedicos.ZonaAfectada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="Densidad zona donante" Text="{x:Bind ViewModel.DatosMedicos.DensidadZonaDonante, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Calidad del cabello" Text="{x:Bind ViewModel.DatosMedicos.CalidadCabello, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="Color" Text="{x:Bind ViewModel.DatosMedicos.ColorCabello, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Header="Grosor" Text="{x:Bind ViewModel.DatosMedicos.GrosorCabello, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <ComboBox
                            Header="Médico responsable"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Doctores.Nombres, Mode=OneWay}"
                            PlaceholderText="Seleccionar médico"
                            SelectedItem="{x:Bind ViewModel.DatosMedicos.MedicoResponsable, Mode=TwoWay}" />
                        <TextBox AcceptsReturn="True" Header="Diagnóstico" Height="80" Text="{x:Bind ViewModel.DatosMedicos.Diagnostico, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Plan de tratamiento" Height="90" PlaceholderText="ARTAS, FUE, PRP, láser, indicaciones médicas..." Text="{x:Bind ViewModel.DatosMedicos.PlanTratamiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <TextBox AcceptsReturn="True" Header="Observaciones médicas" Height="80" Text="{x:Bind ViewModel.DatosMedicos.ObservacionesMedicas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <Button Click="GuardarMedicos_Click" Content="Guardar evaluación capilar" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Citas">
                <Grid Padding="4,16,4,8" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="Citas vinculadas a este expediente." />
                        <Button HorizontalAlignment="Right" Click="NuevaCita_Click" Content="Agendar cita" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="Este paciente aún no tiene citas."
                        Visibility="{x:Bind ViewModel.SinCitas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Citas, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HayCitas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Cita">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{x:Bind ColorEstado}" CornerRadius="4" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Tipo}" />
                                        <TextBlock Opacity="0.75" Text="{x:Bind Resumen}" />
                                        <TextBlock Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Estado}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Click="ComprobanteCita_Click" Content="Boleta o factura" Tag="{x:Bind}" />
                                        <Button Click="EditarCita_Click" Content="Editar" Tag="{x:Bind}" />
                                        <Button Click="EliminarCita_Click" Content="Quitar" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Mapa de zonas">
                <ScrollViewer Padding="4,16,4,8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Opacity="0.78"
                            TextWrapping="Wrap"
                            Text="Resumen de todas las operaciones del paciente: cabeza, frente y dorso. Lo marcado se acumula a lo largo de su tiempo en la clínica." />
                        <TextBlock
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ZonasResumenTexto, Mode=OneWay}" />
                        <controls:MapaCabezaControl
                            HorizontalAlignment="Left"
                            ForzarTresVistas="True"
                            IsHitTestVisible="False"
                            SoloLectura="True"
                            Zonas="{x:Bind ViewModel.ZonasResumen, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Operaciones">
                <Grid Padding="4,16,4,8" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="Cada tarjeta es una operación distinta. Use Ver para el procedimiento u ordene de nuevas a antiguas." />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            Header="Orden"
                            ItemsSource="{x:Bind ViewModel.FiltrosOperacion}"
                            SelectedItem="{x:Bind ViewModel.FiltroOperaciones, Mode=TwoWay}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Click="NuevoProcedimiento_Click"
                            Content="Registrar operación"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="{x:Bind ViewModel.VacioFiltroTexto, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SinProcedimientos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="{x:Bind ViewModel.VacioFiltroTexto, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SinProcedimientosVisibles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.ProcedimientosVisibles, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HayProcedimientosVisibles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,16" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Procedimiento">
                                <Border
                                    Padding="16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind TituloLista}"
                                                    TextWrapping="Wrap" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind EstadoBrocha}"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{x:Bind Estado}" />
                                                </Border>
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind EtiquetaTiempo}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Opacity="0.78"
                                                TextWrapping="Wrap"
                                                Text="{x:Bind DescripcionProcedimiento}" />
                                            <TextBlock Opacity="0.78" TextWrapping="Wrap" Text="{x:Bind DetalleLista}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Opacity="0.85" Text="Observaciones del médico" />
                                                <TextBlock
                                                    Opacity="0.78"
                                                    TextWrapping="Wrap"
                                                    Text="{x:Bind ObservacionesMedicoTexto}" />
                                            </StackPanel>
                                            <controls:MapaCabezaControl
                                                MinWidth="420"
                                                HorizontalAlignment="Left"
                                                IsHitTestVisible="False"
                                                SoloLectura="True"
                                                Zonas="{x:Bind ZonasOperadas, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Spacing="8">
                                            <Button
                                                MinWidth="108"
                                                HorizontalAlignment="Stretch"
                                                Click="VerProcedimiento_Click"
                                                Content="Ver"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{x:Bind}" />
                                            <Button
                                                MinWidth="108"
                                                HorizontalAlignment="Stretch"
                                                Click="EditarProcedimiento_Click"
                                                Content="Editar"
                                                Tag="{x:Bind}" />
                                            <Button
                                                MinWidth="108"
                                                HorizontalAlignment="Stretch"
                                                Click="EliminarProcedimiento_Click"
                                                Content="Quitar"
                                                Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Observaciones">
                <Grid Padding="4,16,4,8" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="Notas de consulta, evolución y seguimiento clínico." />
                        <Button HorizontalAlignment="Right" Click="NuevaObservacion_Click" Content="Nueva observación" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,32"
                        HorizontalAlignment="Center"
                        Opacity="0.65"
                        Text="No hay observaciones en este expediente."
                        Visibility="{x:Bind ViewModel.SinObservaciones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Observaciones, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.HayObservaciones, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Observacion">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Encabezado}" />
                                        <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="{x:Bind Contenido}" />
                                        <TextBlock Margin="0,4,0,0" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Pie}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="EditarObservacion_Click" Content="Editar" Tag="{x:Bind}" />
                                        <Button Click="EliminarObservacion_Click" Content="Quitar" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
        </Grid>

        <InfoBar
            Canvas.ZIndex="10"
            IsOpen="{x:Bind ViewModel.MensajeVisible, Mode=TwoWay}"
            Message="{x:Bind ViewModel.Mensaje, Mode=OneWay}"
            Severity="{x:Bind ViewModel.Severidad, Mode=OneWay}"
            Style="{StaticResource OverlayInfoBarStyle}" />
    </Grid>
</Page>
