<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaCapilar_Historial.Pages.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaCapilar_Historial.Models"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Style="{StaticResource PageRootStyle}" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="HISTORIAL MÉDICO" Opacity="0.7" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.NombreClinica, Mode=OneWay}" />
                <TextBlock
                    Opacity="0.75"
                    TextWrapping="Wrap"
                    Text="Expediente clínico para registrar y consultar datos del paciente, evaluación capilar, operaciones capilares y de reducción de grasa, y seguimiento." />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Click="Pacientes_Click"
                    Style="{StaticResource StatCardButtonStyle}"
                    ToolTipService.ToolTip="Ver todos los expedientes">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PACIENTES" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Stats.TotalPacientes, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="Expedientes registrados" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Click="Activos_Click"
                    Style="{StaticResource StatCardButtonStyle}"
                    ToolTipService.ToolTip="Ver expedientes activos">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACTIVOS" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Stats.ExpedientesActivos, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="Historias en seguimiento" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Click="CitasHoy_Click"
                    Style="{StaticResource StatCardButtonStyle}"
                    ToolTipService.ToolTip="Ver citas de hoy">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CITAS HOY" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Stats.CitasHoy, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="Programadas para hoy" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    Click="Pendientes_Click"
                    Style="{StaticResource StatCardButtonStyle}"
                    ToolTipService.ToolTip="Ver citas pendientes">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PENDIENTES" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Stats.CitasProximas, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="Citas por atender" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="4"
                    Click="Operaciones_Click"
                    Style="{StaticResource StatCardButtonStyle}"
                    ToolTipService.ToolTip="Ver lista de operaciones">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="OPERACIONES" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Stats.TotalOperaciones, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="Registradas en el historial" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Pacientes recientes" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="NuevoExpediente_Click"
                                Content="Nuevo expediente"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,24"
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="Aún no hay expedientes. Cree el primero para comenzar."
                            Visibility="{x:Bind ViewModel.SinRecientes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ListView
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="Paciente_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Recientes, Mode=OneWay}"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.HayRecientes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Paciente">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="VerFoto_Click"
                                            CornerRadius="999"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Ver fotografía">
                                            <PersonPicture
                                                Width="40"
                                                Height="40"
                                                DisplayName="{x:Bind NombreCompleto}"
                                                ProfilePicture="{x:Bind Foto, Mode=OneWay}" />
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind NombreCompleto}" />
                                            <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitulo}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Próximas citas" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="VerAgenda_Click"
                                Content="Ver agenda" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,24"
                            HorizontalAlignment="Center"
                            Opacity="0.6"
                            Text="No hay citas programadas."
                            Visibility="{x:Bind ViewModel.SinCitas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ListView
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="Cita_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Citas, Mode=OneWay}"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.HayCitas, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Cita">
                                    <StackPanel Padding="0,8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind NombrePaciente}" />
                                        <TextBlock Opacity="0.75" Text="{x:Bind Tipo}" />
                                        <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Resumen}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
